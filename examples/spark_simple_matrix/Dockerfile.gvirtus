# Multi-stage build: build GVirtuS frontend from nvidia base image, then copy
# frontend stubs to plain Ubuntu. This ensures RAPIDS JNI loads GVirtuS stubs (no real CUDA libs).

# ════════════════════════════════════════════════════════════════════════════════
# Stage 1: Build GVirtuS frontend from nvidia CUDA devel image
# ════════════════════════════════════════════════════════════════════════════════
FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libxmu-dev \
        libxi-dev \
        libgl-dev \
        libosmesa-dev \
        liblog4cplus-dev \
        librdmacm-dev \
        libibverbs-dev \
        libgtest-dev \
        liblz4-dev \
        cmake \
    && rm -rf /var/lib/apt/lists/*

ENV GVIRTUS_HOME=/opt/GVirtuS

# Copy GVirtuS source and build
COPY cmake /gvirtus/cmake
COPY etc /gvirtus/etc
COPY include /gvirtus/include
COPY plugins /gvirtus/plugins
COPY src /gvirtus/src
COPY tools /gvirtus/tools
COPY tests /gvirtus/tests
COPY CMakeLists.txt /gvirtus/

WORKDIR /gvirtus/build
RUN cmake .. && make -j$(nproc) && make install

# Verify the frontend stubs exist
RUN echo "=== GVirtuS frontend libs ===" && \
    ls -la ${GVIRTUS_HOME}/lib/frontend/ && \
    ls -la ${GVIRTUS_HOME}/lib/

# ════════════════════════════════════════════════════════════════════════════════
# Stage 2: Runtime — plain Ubuntu (NO real CUDA libs)
# ════════════════════════════════════════════════════════════════════════════════
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Runtime dependencies only (Java, Python, GVirtuS runtime libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        python3 \
        python3-pip \
        python3-venv \
        liblog4cplus-dev \
        librdmacm-dev \
        libibverbs-dev \
        liblz4-dev \
        procps \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV GVIRTUS_HOME=/opt/GVirtuS

# Copy GVirtuS install from builder (frontend stubs + shared support libs)
COPY --from=builder ${GVIRTUS_HOME} ${GVIRTUS_HOME}

# Verify no real CUDA libs exist — only GVirtuS stubs
RUN echo "=== Checking: no real CUDA libs ===" && \
    ! test -d /usr/local/cuda && \
    echo "OK: /usr/local/cuda does not exist" && \
    echo "=== GVirtuS frontend stubs ===" && \
    ls -la ${GVIRTUS_HOME}/lib/frontend/

# ── Python deps (PySpark, numpy, etc.) ──
COPY examples/spark_simple_matrix/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Verify Spark is reachable
RUN python3 -c "import pyspark; print(f'PySpark {pyspark.__version__} OK')"

# ── GVirtuS environment (set here so ALL processes use GVirtuS stubs) ──
ENV GVIRTUS_HOME=/opt/GVirtuS \
    GVIRTUS_LOGLEVEL=40000 \
    LD_LIBRARY_PATH=/opt/GVirtuS/lib/frontend:/opt/GVirtuS/lib \
    LD_PRELOAD=/opt/GVirtuS/lib/frontend/libcudart.so:/opt/GVirtuS/lib/frontend/libcuda.so

# ── Working directory ──
WORKDIR /app/src

# Simple entrypoint (env vars already set above)
COPY examples/spark_simple_matrix/entrypoint-gvirtus.sh /entrypoint-gvirtus.sh
RUN chmod +x /entrypoint-gvirtus.sh

ENTRYPOINT ["/entrypoint-gvirtus.sh"]

