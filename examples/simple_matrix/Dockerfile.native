FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /benchmark
COPY simple_matrix.cu benchmark_native.sh ./
RUN chmod +x benchmark_native.sh

# Pre-compile the benchmark
RUN nvcc simple_matrix.cu -o simple_matrix_native -O2 \
    -L${CUDA_HOME}/lib64 -lcuda -lcudart -lcublas

ENV MATRIX_SIZES="128 256 512 1024 2048 4096 8192 16384"
ENV ITERATIONS=10
ENV WARMUP=2

CMD ["./benchmark_native.sh"]
