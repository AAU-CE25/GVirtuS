# Example UCX profile — copy to <hostname -s>.env and edit, OR generate via
# ./generate-profile.sh > etc/ucx/$(hostname -s).env
#
# These are make-style variable assignments included by the top-level Makefile
# when its `hostname -s` matches the filename.

# RDMA device name and port. Examples:
#   mlx5_0:1   — first Mellanox device, port 1 (common single-NIC host)
#   mlx5_2:1   — BlueField device on a host with multiple Mellanox NICs
UCX_DEV     := mlx5_0:1

# GID index for RoCE v2 on the RDMA NIC. Use `show_gids` and find the row
# whose IP matches HOST_IP and whose type is `v2`.
UCX_GID_IDX := 1

# Transport list passed to UCX_TLS. `rc_verbs,tcp` is the working combo on
# Mellanox RoCE NICs; fall back to plain `tcp` to bypass RDMA for debugging.
UCX_TLS     := rc_verbs,tcp

# IP that lives on this host's RDMA NIC (used as the bind/listen address when
# this host runs the GVirtuS backend).
HOST_IP      := 24.24.24.1

# IP of the peer's RDMA NIC (used as the dial-target when this host runs the
# GVirtuS frontend/client).
HOST_IP_PEER := 24.24.24.2

# Plain-TCP fallback netdev name (used only when UCX_TLS=tcp). Must be the
# netdev whose address is HOST_IP.
HOST_NETDEV  := ens7f0np0

# TCP port the UCX listener binds to / the client dials.
UCX_PORT     := 7676
