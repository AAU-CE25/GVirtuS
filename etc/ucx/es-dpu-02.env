# UCX profile for es-dpu-02
#
# Sourced by the top-level Makefile when running ON this host. Pins the
# correct interface, GID index, and IP for the 24.24.24.x RDMA link.

# RoCE: on dpu-02 the BlueField device enumerates as mlx5_0 port 1.
UCX_DEV     := mlx5_0:1
UCX_GID_IDX := 1
UCX_TLS     := rc_verbs,tcp

# IP that lives on this host's RDMA NIC.
HOST_IP      := 24.24.24.2
HOST_IP_PEER := 24.24.24.1

# Plain-TCP fallback netdev name.
HOST_NETDEV  := ens1f0np0

# UCX endpoint TCP port used by the GVirtuS backend listener.
UCX_PORT     := 7676
