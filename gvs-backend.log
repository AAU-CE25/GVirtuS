docker run \
	--rm \
	-it \
	--network host \
	--privileged \
	-v ./cmake:/gvirtus/cmake/ \
	-v ./etc:/gvirtus/etc/ \
	-v ./include:/gvirtus/include/ \
	-v ./plugins:/gvirtus/plugins/ \
	-v ./src:/gvirtus/src/ \
	-v ./tools:/gvirtus/tools/ \
	-v ./tests:/gvirtus/tests/ \
	-v ./CMakeLists.txt:/gvirtus/CMakeLists.txt \
	-v ./docker/dev/entrypoint.sh:/entrypoint.sh \
	-v ./examples:/gvirtus/examples/ \
	--entrypoint /entrypoint.sh \
	--name gvirtus-kz08ey \
	--runtime=nvidia \
	--shm-size=8G \
	-e GVIRTUS_LOGLEVEL=10000 \
	-e GVIRTUS_UCX_DATAPATH=am \
	-e UCX_TLS=rc_mlx5,ud_mlx5,self \
	-e UCX_NET_DEVICES=mlx5_1:1 \
	-e UCX_LOG_LEVEL=info \
	-e UCX_SOCKADDR_TLS_PRIORITY=rdmacm \
	entor/gvirtus-dev:cuda12.6.3-cudnn-ubuntu22.04
