# La campana ASPLOS exige que cada numero tenga su crudo citable desde el artifact.
# Excepcion acotada a su arbol de resultados; el resto del repo sigue excluyendo *.log/*.csv.
!results/asplos_campaign/**/*.log
!results/asplos_campaign/**/*.csv
!results/asplos_campaign/**/*.txt
!results/asplos_campaign/**/*.json

# Binarios compilados de los tests semanticos: son artefactos, no fuentes. Sin esto la
# procedencia marca worktree_dirty=true y la campana final parece salir de un arbol sucio.
tests/semantic/*
!tests/semantic/*.cu
!tests/semantic/*.sh

# Arboles de build alternativos y capturas A/B: deliberadamente fuera del repo.
build_*/
ab_pre/
