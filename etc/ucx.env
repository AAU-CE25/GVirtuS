# === GVirtuS UCX Transport Configuration ===
# Uncomment ONE preset section below, or set values individually.
# After changes: make stop-gvirtus && make run-gvirtus-backend-dev
#
# Run `make ucx-discover` (or inside container: `make ucx-discover-docker`)
# to see available hardware and pick the right values for your system.

# --- Preset: Mixed TCP + RDMA (recommended for containers) ---
UCX_TLS=rc_mlx5,ud_mlx5,tcp,self
UCX_NET_DEVICES=mlx5_1:1,ens1f1np1
UCX_SOCKADDR_TLS_PRIORITY=tcp
UCX_IB_GID_INDEX=3

# --- Preset: RDMA only (maximum performance) ---
# UCX_TLS=rc_mlx5,ud_mlx5,self
# UCX_NET_DEVICES=mlx5_1:1
# UCX_SOCKADDR_TLS_PRIORITY=rdmacm
# UCX_IB_GID_INDEX=3

# --- Preset: TCP only (validation baseline, no RDMA required) ---
# UCX_TLS=tcp,self
# UCX_NET_DEVICES=ens1f1np1
# UCX_SOCKADDR_TLS_PRIORITY=tcp
# UCX_IB_GID_INDEX=

# --- GVirtuS application options ---
GVIRTUS_LOG_LEVEL=10000
GVIRTUS_UCX_DATAPATH=am
GVIRTUS_GPUDIRECT=1
GVIRTUS_RMA_ZEROCOPY=0

# --- UCX diagnostics ---
UCX_LOG_LEVEL=info
