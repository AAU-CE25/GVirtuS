# Multi-stage build: use pre-built GVirtuS dev image, then copy frontend stubs
# to plain Ubuntu. This ensures RAPIDS JNI loads GVirtuS stubs (no real CUDA libs).

# ════════════════════════════════════════════════════════════════════════════════
# Stage 1: Use existing gvirtus-dev image (has all plugins built)
# ════════════════════════════════════════════════════════════════════════════════
FROM aauce25/gvirtus-dev:cuda12.6.3-cudnn-ubuntu22.04 AS builder

# GVirtuS is already installed at /opt/GVirtuS
# Just verify the frontend stubs exist
RUN echo "=== GVirtuS frontend libs from dev image ===" && \
    ls -la /opt/GVirtuS/lib/frontend/ && \
    ls -la /opt/GVirtuS/lib/

# ════════════════════════════════════════════════════════════════════════════════
# Stage 2: Runtime — plain Ubuntu (NO real CUDA libs)
# ════════════════════════════════════════════════════════════════════════════════
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Runtime dependencies only (Java, Python, GVirtuS runtime libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        python3 \
        python3-pip \
        python3-venv \
        liblog4cplus-dev \
        librdmacm-dev \
        libibverbs-dev \
        liblz4-dev \
        procps \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV GVIRTUS_HOME=/opt/GVirtuS

# Copy GVirtuS install from builder (frontend stubs + shared support libs)
COPY --from=builder ${GVIRTUS_HOME} ${GVIRTUS_HOME}

# Verify no real CUDA libs exist — only GVirtuS stubs
RUN echo "=== Checking: no real CUDA libs ===" && \
    ! test -d /usr/local/cuda && \
    echo "OK: /usr/local/cuda does not exist" && \
    echo "=== GVirtuS frontend stubs ===" && \
    ls -la ${GVIRTUS_HOME}/lib/frontend/

# ── Python deps (PySpark, numpy, etc.) ──
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Verify Spark is reachable
RUN python3 -c "import pyspark; print(f'PySpark {pyspark.__version__} OK')"

# ── Working directory ──
WORKDIR /app/src

# GVirtuS frontend entrypoint sets LD_LIBRARY_PATH
COPY entrypoint-gvirtus.sh /entrypoint-gvirtus.sh
RUN chmod +x /entrypoint-gvirtus.sh

ENTRYPOINT ["/entrypoint-gvirtus.sh"]

